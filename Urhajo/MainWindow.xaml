<Window x:Class="Urhajo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Urhajo"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Vertical" Grid.Column="0" Background="DarkBlue">
            <Label Content="Űrhajó műveletek" FontSize="20"/>
            <Button Width="250" Height="30" Margin="10" Content="Adatok betöltése" Click="Betolt"/>
            <Button Width="250" Height="30" Margin="10" Content="Hány űrhajó van?" Click="Osszesurhajo"/>
            <Button Width="250" Height="30" Margin="10" Content="Legnagyobb hatótáv?" Click="legnagyobbhatotav"/>
            <Button Width="250" Height="30" Margin="10" Content="Kik voltak sikeres küldetésen?" Click="Sikeresek"/>
            <Button Width="250" Height="30" Margin="10" Content="Átlagos legénységszám" Click="Atlaglegenyseg"/>
            <Button Width="250" Height="30" Margin="10" Content="Gyártók szerinti csoportosítás" Click="Gyartokszerint"/>
            <Button Width="250" Height="30" Margin="10" Content="Keresés név alapján" Click="Nevkereses"/>
            <ProgressBar x:Name="progressbar" Width="250" Height="20" Margin="15" />
        </StackPanel>
        <StackPanel Grid.Column="1">
            <DataGrid x:Name="datagrid"  Margin="5" MaxHeight="200" SelectionChanged="selectchange" />
        </StackPanel>
    </Grid>
</Window>
